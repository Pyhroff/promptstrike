# Normalize line endings to LF on commit
* text=auto eol=lf

# Python
*.py    text eol=lf
*.toml  text eol=lf

# Web / templates
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf

# Config / docs
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.env   text eol=lf

# Binary — never diff/merge
*.db    binary
*.pyc   binary
